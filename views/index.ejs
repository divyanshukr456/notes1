
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Notes | Dashboard</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-950 text-white min-h-screen">

    <div class="main w-full min-h-screen">

        <!-- Navbar -->
        <nav class="w-full px-6 md:px-12 py-6 border-b border-zinc-800 flex justify-between items-center">

            <h1 class="text-2xl font-bold tracking-tight">
                Notes<span class="text-blue-500">.</span>
            </h1>

            <p class="text-sm text-zinc-400">
                Your personal workspace
            </p>

        </nav>


        <!-- Main Container -->
        <div class="max-w-6xl mx-auto px-6 py-12">

            <!-- Heading -->
            <div class="mb-10">

                <p class="text-blue-500 text-sm font-semibold mb-2">
                    YOUR WORKSPACE
                </p>

                <h1 class="text-4xl md:text-5xl font-bold mb-3">
                    My Notes
                </h1>

                <p class="text-zinc-400">
                    Capture your thoughts, ideas and tasks.
                </p>

            </div>


            <!-- Create Note Form -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 md:p-8 mb-12">

                <h2 class="text-xl font-semibold mb-6">
                    Create a new note
                </h2>

                <form action="/add" method="POST" class="space-y-4">

                    <!-- Title -->
                    <div>

                        <label class="block text-sm text-zinc-400 mb-2">
                            Note Title
                        </label>

                        <input
                            type="text"
                            name="title"
                            placeholder="Enter your note title..."
                            required
                            class="w-full px-5 py-3 bg-zinc-800 border border-zinc-700 rounded-xl outline-none focus:border-blue-500 transition"
                        >

                    </div>


                    <!-- Description -->
                    <div>

                        <label class="block text-sm text-zinc-400 mb-2">
                            Description
                        </label>

                        <textarea
                            name="content"
                            rows="5"
                            placeholder="Write something here..."
                            required
                            class="w-full px-5 py-3 bg-zinc-800 border border-zinc-700 rounded-xl outline-none focus:border-blue-500 resize-none focus:border-blue-500 transition"
                        ></textarea>

                    </div>


                    <!-- Submit -->
                    <button
                        type="submit"
                        class="px-7 py-3 bg-blue-600 hover:bg-blue-700 rounded-xl font-semibold transition cursor-pointer"
                    >
                        + Create Note
                    </button>

                </form>

            </div>


            <!-- Notes Header -->
            <div class="flex justify-between items-center mb-6">

                <div>
                    <h2 class="text-2xl font-bold">
                        All Notes
                    </h2>

                    <p class="text-sm text-zinc-500 mt-1">
                        <%= notes.length %> notes created
                    </p>
                </div>

            </div>


            <!-- Search -->
            <div class="mb-8">

                <input
                    id="searchInput"
                    type="text"
                    placeholder="Search your notes..."
                    class="w-full md:w-96 px-5 py-3 bg-zinc-900 border border-zinc-800 rounded-xl outline-none focus:border-blue-500"
                >

            </div>


            <!-- Notes Grid -->
            <div id="notesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <% if (notes.length === 0) { %>

                    <div class="col-span-full text-center py-20 border border-dashed border-zinc-800 rounded-2xl">

                        <h3 class="text-xl font-semibold mb-2">
                            No notes yet!
                        </h3>

                        <p class="text-zinc-500">
                            Create your first note to get started.
                        </p>

                    </div>

                <% } %>


                <% notes.forEach(note => { %>

                    <div class="note-card bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-blue-500/50 transition">

                        <div class="flex justify-between items-start mb-4">

                            <h3 class="note-title text-xl font-semibold break-words">
                                <%= note.title %>
                            </h3>

                            <span class="text-blue-500 text-xs">
                                NOTE
                            </span>

                        </div>


                        <p class="note-content text-zinc-400 text-sm leading-7 whitespace-pre-wrap break-words mb-6"><%= note.content %></p>


                        <div class="flex justify-between items-center border-t border-zinc-800 pt-4">

                            <small class="text-zinc-600">
                                <%= note.date %>
                            </small>


                            <form action="/delete/<%= note.id %>" method="POST">

                                <button
                                    type="submit"
                                    class="text-red-400 hover:text-red-300 text-sm cursor-pointer"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>

            <p id="noResults" class="hidden text-center text-zinc-500 py-10">
                No matching notes found.
            </p>


            <!-- Footer -->
            <footer class="text-center text-zinc-600 text-sm mt-20 border-t border-zinc-900 pt-8">

                Made with care. Keep your thoughts organized.

            </footer>

        </div>

    </div>


    <!-- Frontend JavaScript -->
    <script>

        const searchInput = document.getElementById("searchInput");
        const noteCards = document.querySelectorAll(".note-card");
        const noResults = document.getElementById("noResults");

        searchInput.addEventListener("input", function () {

            const searchValue = this.value.toLowerCase();

            let visibleCount = 0;

            noteCards.forEach(card => {

                const title = card.querySelector(".note-title").textContent.toLowerCase();

                const content = card.querySelector(".note-content").textContent.toLowerCase();

                const matches = title.includes(searchValue) || content.includes(searchValue);

                card.style.display = matches ? "block" : "none";

                if (matches) visibleCount++;

            });

            noResults.classList.toggle("hidden", visibleCount !== 0);

        });

    </script>

</body>
</html>
